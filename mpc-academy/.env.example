# ---------------------------------------------------------------------------
# MPC Academy — environment variables
# Copy this file to `.env.local` and fill in as features come online.
# Nothing here is required for the scaffold to run.
# ---------------------------------------------------------------------------

# Google integration (no backend) — Phase 1 is Google Sheets ONLY.
# Deployed Apps Script Web App URL that reads/writes rows in the Google Sheet.
# Leave blank to run against the built-in in-memory mock (dev works with no
# Google setup). See apps-script/README.md for the full setup guide.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# The Google Sheet that stores submissions. The Apps Script already knows these
# (set in CONFIG); these are optional in the app and kept for reference/tooling.
NEXT_PUBLIC_GOOGLE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_SHEET_NAME=Submissions

# Authentication (future). Currently using a mock user system — see
# src/lib/access.ts. No auth env vars are required to run the app.
# When reintroducing auth later, add your provider's keys here.

# Stripe (future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI coaching (future)
# ANTHROPIC_API_KEY=
