# ---------------------------------------------------------------------------
# MPC Academy — environment variables
# Copy this file to `.env.local` and fill in as features come online.
# Nothing here is required for the scaffold to run.
# ---------------------------------------------------------------------------

# Google integration (no backend). Deployed Apps Script Web App URL that
# writes videos to Drive and appends a row to Sheets.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# Authentication (future). Currently using a mock user system — see
# src/lib/access.ts. No auth env vars are required to run the app.
# When reintroducing auth later, add your provider's keys here.

# Stripe (future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI coaching (future)
# ANTHROPIC_API_KEY=
