# ---------------------------------------------------------------------------
# MPC Academy — environment variables
# Copy this file to `.env.local` and fill in as features come online.
# Nothing here is required for the scaffold to run.
# ---------------------------------------------------------------------------

# Apps Script Web App — the METADATA backend (Google Sheets only; no video
# bytes ever go through it). Reads/writes submissions, feedback, status, ratings.
# Leave blank to run against the built-in in-memory mock (dev works with no
# Google setup). See apps-script/README.md for the full setup guide.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# The Google Sheet that stores submissions. The Apps Script already knows these
# (set in CONFIG); these are optional in the app and kept for reference/tooling.
NEXT_PUBLIC_GOOGLE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_SHEET_NAME=Submissions

# Google Drive — DIRECT resumable upload from the browser (up to 3GB).
# The OAuth 2.0 Client ID (Web application) authorises the Drive upload via
# Google Identity Services with the narrow `drive.file` scope. This is Drive
# authorization only — NOT app/member login. Leave blank to skip uploads in dev
# (submissions record metadata with an empty video URL).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_ROOT_FOLDER_NAME=MPC Academy Submissions
#   Sharing: ANYONE_WITH_LINK | DOMAIN | PRIVATE
NEXT_PUBLIC_GOOGLE_DRIVE_SHARING=ANYONE_WITH_LINK

# Authentication (future). Currently using a mock user system — see
# src/lib/access.ts. No auth env vars are required to run the app.
# When reintroducing auth later, add your provider's keys here.

# Stripe (future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI coaching (future)
# ANTHROPIC_API_KEY=
