# ---------------------------------------------------------------------------
# MPC Academy — environment variables
# Copy this file to `.env.local` and fill in as features come online.
# The app runs WITHOUT any of these set (Phase 1 keeps the live UI on the seed
# implementation — no live Supabase project is required to run locally).
# ---------------------------------------------------------------------------

# === PUBLIC (safe to expose to the browser) ================================
# Supabase project URL and anon key. These are public by design; every row is
# still governed by RLS. Only these two Supabase values may use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Authoritative timezone for calendar-month entitlements (decision E).
# Defaults to Europe/London in code if unset.
APP_TIMEZONE=Europe/London

# === SERVER-ONLY (NEVER expose to the browser) =============================
# Supabase service-role key. Bypasses RLS. MUST NOT be prefixed NEXT_PUBLIC_
# and MUST NOT appear in any client bundle. Server-side, trusted tasks only.
SUPABASE_SERVICE_ROLE_KEY=

# === RETENTION (placeholders — DO NOT invent legal periods) ================
# Decision 6: retention periods stay UNSET until MPC approves them. Leave blank.
# These are documentation placeholders; nothing enforces deletion in Phase 1.
VIDEO_RETENTION_DAYS=
FEEDBACK_RETENTION_DAYS=
SUBMISSION_RETENTION_DAYS=
TECH_LOG_RETENTION_DAYS=
INACTIVE_MEMBER_RETENTION_DAYS=

# === LEGACY (Google — frozen, do not expand; see docs/SECURITY.md) =========
# Deployed Apps Script Web App URL. This is an UNAUTHENTICATED write endpoint
# (public /exec URL). Documented security limitation — see docs/SECURITY.md.
# Being retired across the V2 phases; kept functioning during Phase 1 only.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# === FUTURE (not used in Phase 1) ==========================================
# Cloudflare Stream (Phase 3)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# Squarespace membership verification (Phase 2)
# SQUARESPACE_API_KEY=
